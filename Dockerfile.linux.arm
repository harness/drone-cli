FROM alpine:3.24 AS patched-arm-certificates
RUN apk add --no-cache 'ca-certificates>=20261020-r0'

FROM alpine:3.24 as alpine
RUN apk add -U --no-cache ca-certificates

FROM arm32v7/alpine:3.19
COPY --from=patched-arm-certificates /etc/ssl/certs/ca-certificates.crt /etc/patched-ca/certs/ca-certificates.crt
ENV SSL_CERT_FILE=/etc/patched-ca/certs/ca-certificates.crt SSL_CERT_DIR=/etc/patched-ca/certs

ENV GODEBUG netdns=go

# Add security updates
RUN apk add -U --no-cache ca-certificates zlib openssl busybox && \
    # Create a non-root user
    addgroup -S drone && \
    adduser -S -G drone drone

COPY --from=alpine /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/

COPY release/linux/arm/drone /bin/

# Change ownership of the binary to the non-root user
RUN chmod +x /bin/drone && \
    chown drone:drone /bin/drone

# Switch to non-root user
USER drone

ENTRYPOINT ["/bin/drone"]

# CA bundles are architecture-independent; use the patched HHI roots on legacy ARM.
COPY --from=patched-arm-certificates /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
