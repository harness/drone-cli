FROM harness0.harness.io/oci/docker_artifacts/hhi/harnessos-alpine:1 as alpine
RUN apk add -U --no-cache ca-certificates

FROM harness0.harness.io/oci/docker_artifacts/hhi/harnessos-alpine:1

ENV GODEBUG netdns=go

# Add security updates
RUN apk add -U --no-cache ca-certificates zlib openssl busybox && \
    # Create a non-root user
    addgroup -S drone && \
    adduser -S -G drone drone

COPY --from=alpine /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/

COPY release/linux/arm64/drone /bin/

# Change ownership of the binary to the non-root user
RUN chmod +x /bin/drone && \
    chown drone:drone /bin/drone

# Switch to non-root user
USER drone

ENTRYPOINT ["/bin/drone"]
